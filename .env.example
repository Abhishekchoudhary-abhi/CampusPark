# Frontend environment variables for Vite
# (These need to be added to Vercel Dashboard -> Environment Variables)

# ✅ REQUIRED: Your Render backend URL
# Example: https://campus-backend-4t1u.onrender.com
# NO trailing slash!
VITE_API_URL=https://campus-backend-4t1u.onrender.com
VITE_API_BASE=https://campus-backend-4t1u.onrender.com

# Backend (Render) environment variables
# (Add these to Render Dashboard -> Environment Variables)
MONGODB_URI=your_mongodb_atlas_uri
PORT=5000
JWT_SECRET=your_super_secret_key
